# Project-scoped, non-secret environment variables -- committed to the repo,
# unlike the per-user secrets file (see load-env.sh). Loaded automatically by
# load-env.sh alongside that file.

# Copying .devcontainer/ into a new project? Change this to that project's
# own path. It's the per-user secrets file load-env.sh reads -- left as-is, a
# copy would keep reading (and writing setup instructions pointing at) this
# project's secrets file instead of its own.
PROJECT_SECRETS_FILE="${HOME}/project-secrets/kuberpult/secrets.env.local"

REVOLUTION_WORKSPACE_ID=-JqFGExX46gs9mH7vxR5
REVOLUTION_PRODUCT_ID=-P0LfpQ-98pqfh8vat-H
